GLOBALS {                           
  int @number = 3;
  const proc @suma = function (int @a, int @b) { return + @a @b };
} PROGRAM {
  proc @main = function () { 
    return switch (@number){
		case 1:{
			print("Nada")
		}
		case 2:{
			print("Aún nada")
		}
		case 3:{
			print("Ni pio", =>@suma(20,22))
		}
		default: {
			"_casoPorDefecto"
		}
	}
  }
}

